# ─── NextAuth (Auth.js v5) ───────────────────────────────────────────────────
# `openssl rand -base64 32` bilan yarating.
AUTH_SECRET=change-me-nextauth-secret

# ─── Backend (NestJS) ────────────────────────────────────────────────────────
# BFF proxy va login shu manzilga uzatadi. Faqat SERVER tomonda ishlatiladi
# (NEXT_PUBLIC_ emas — brauzerga chiqmaydi).
# Local:  http://localhost:4000
# Prod:   https://api.oneroom.uz  (DigitalOcean VPS)
BACKEND_URL=http://localhost:4000

# Backend bilan bir xil sir — BFF so'rovlarini himoyalash uchun.
# Backend .env dagi INTERNAL_API_SECRET bilan AYNAN bir xil bo'lishi kerak.
INTERNAL_API_SECRET=
