# ─── NextAuth (Auth.js v5) ───────────────────────────────────────────────────
# Server backend bilan bir xil bo'lishi kerak.
AUTH_SECRET=change-me-nextauth-secret

# ─── Backend (NestJS) ────────────────────────────────────────────────────────
# BFF proxy va login shu manzilga uzatadi. Faqat SERVER tomonda ishlatiladi
# (NEXT_PUBLIC_ emas — brauzerga chiqmaydi).
#
# Lokal backend:  BACKEND_URL=http://localhost:4000
# Server backend: BACKEND_URL=https://api.oneroom.uz
BACKEND_URL=http://localhost:4000

# Backend .env dagi INTERNAL_API_SECRET bilan AYNAN bir xil bo'lishi kerak.
INTERNAL_API_SECRET=
